<div class="page-header">
  <div>
    <div class="brand-name">Morikoya Hotel</div>
    <div class="brand-sub">Transactions</div>
  </div>
  <%= link_to "Add Transaction", new_transaction_path, class: "btn-primary" %>
</div>
<div class="metrics-grid">
  <div class="metric-card metric-income">
    <div class="metric-label">Monthly Income</div>
    <div class="metric-value"><%= number_to_currency(@income, unit: "¥", precision: 0) %></div>
  </div>
  <div class="metric-card metric-expense">
    <div class="metric-label">Monthly Expense</div>
    <div class="metric-value"><%= number_to_currency(@expense, unit: "¥", precision: 0) %></div>
  </div>
  <div class="metric-card metric-profit">
    <div class="metric-label">Profit</div>
    <div class="metric-value"><%= number_to_currency(@profit, unit: "¥", precision: 0) %></div>
  </div>
</div>
<% if @categories_expenses.any? %>
  <div class="card">
    <div class="card-title">Monthly Category Expenses</div>
    <% @categories_expenses.each do |category, total| %>
      <div class="category-row">
        <span class="category-name"><%= category.to_s.humanize %></span>
        <span class="category-amount"><%= number_to_currency(total, unit: "¥", precision: 0) %></span>
      </div>
    <% end %>
  </div>
<% end %>
<% if @monthly_transactions.exists? %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Amount</th>
          <th>Type</th>
          <th>Category</th>
          <th>Description</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @monthly_transactions.each do |transaction| %>
          <tr>
            <td><%= number_to_currency(transaction.amount, unit: "¥", precision: 0) %></td>
            <td>
              <span class="badge <%= transaction.income? ? "badge-income" : "badge-expense" %>">
                <%= transaction.transaction_type.capitalize %>
              </span>
            </td>
            <td><%= transaction.category.to_s.humanize %></td>
            <td><%= transaction.description %></td>
            <td><%= transaction.date.strftime("%b %d, %Y") %></td>
            <td style="display: flex; gap: 0.5rem;">
              <%= link_to "Edit", edit_transaction_path(transaction), class: "btn-ghost" %>
              <%= link_to "Delete", transaction_path(transaction),
                  data: { turbo_method: :delete, turbo_confirm: "Delete this transaction?" },
                  class: "btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">No transactions this month.</div>
<% end %>
