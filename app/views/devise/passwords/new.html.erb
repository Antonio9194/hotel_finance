<div class="auth-wrapper">
  <div class="auth-card">
    <div class="brand-name" style="text-align: center; margin-bottom: 0.25rem;">Morikoya Hotel</div>
    <div class="brand-sub" style="text-align: center; margin-bottom: 1.5rem;">Reset your password</div>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <div class="card">
        <%= f.error_notification %>
        <%= f.input :email, required: true, autofocus: true, input_html: { autocomplete: "email" } %>
        <div class="form-actions">
          <%= f.button :submit, "Send reset instructions" %>
        </div>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
