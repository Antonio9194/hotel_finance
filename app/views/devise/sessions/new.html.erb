<div class="auth-wrapper">
  <div class="auth-card">
    <div class="brand-name" style="text-align: center; margin-bottom: 0.25rem;">Morikoya Hotel</div>
    <div class="brand-sub" style="text-align: center; margin-bottom: 1.5rem;">Log in to continue</div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="card">
        <%= f.input :email, required: false, autofocus: true, input_html: { autocomplete: "email" } %>
        <%= f.input :password, required: false, input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
        <div class="form-actions">
          <%= f.button :submit, "Log in" %>
        </div>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
